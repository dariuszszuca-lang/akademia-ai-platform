# Hasło dostępu do panelu administracyjnego (/admin).
# Wymagane. Ustaw to samo w Vercel → Settings → Environment Variables.
ADMIN_PASSWORD=zmien-to-haslo

# Sekret do podpisywania cookie. Użyj losowej wartości co najmniej 32 znaki.
SESSION_SECRET=wygeneruj-losowy-sekret-minimum-32-znaki

# Amazon Cognito. Obie wartości są identyfikatorami publicznymi, ale muszą
# wskazywać dokładnie pulę i klienta używane przez frontend.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=eu-central-1_example
NEXT_PUBLIC_COGNITO_CLIENT_ID=example-client-id

# Vercel KV — zmienne wygenerowane automatycznie po włączeniu KV w Vercel dashboard:
# Storage → Create Database → KV → Connect to Project.
# Jeśli KV nie jest skonfigurowane, platforma działa z domyślnymi flagami z src/data/modules.ts.
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
# KV_REST_API_READ_ONLY_TOKEN=...
# KV_URL=redis://...

# Anthropic Claude API. Wymagane dla onboardingu (generowanie profil.md / persona.md)
# oraz dla agentow (CEO, Marketing, Prawny, Wycena, Publikacja).
# Pobierz z: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# Model uzywany przez agenty i onboarding. Domyslnie sonnet (lepszy reasoning).
# Mozna podmienic na haiku zeby obciac koszty.
# Opcje: claude-sonnet-4-6, claude-haiku-4-5, claude-opus-4-7
ANTHROPIC_MODEL=claude-sonnet-4-6

# Property Intelligence Studio — PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/property_studio

# Property Intelligence Studio — chronione źródła w AWS.
# Aplikacja uwierzytelnia się przez Vercel OIDC. Nie dodawaj statycznych
# AWS_ACCESS_KEY_ID ani AWS_SECRET_ACCESS_KEY.
AWS_REGION=eu-central-1
PROPERTY_SOURCE_BUCKET=
PROPERTY_SOURCE_KMS_KEY_ARN=
PROPERTY_SOURCE_SIGNER_ROLE_ARN=
